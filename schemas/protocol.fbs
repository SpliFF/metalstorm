// Spring Web Protocol — FlatBuffers schema
//
// Every WebSocket binary frame starts with a u8 envelope_type byte:
//   0x01 = FlatBuffers message (this schema)
//   0x02 = Entity state full snapshot (custom binary, Tier 2)
//   0x03 = Entity state delta update (custom binary, Tier 2)
//   0x04 = Projectile state snapshot (custom binary)
//
// After the envelope byte, the remaining bytes are a FlatBuffers buffer
// whose root type is ServerMessage (server→client) or ClientMessage (client→server).

namespace SpringWeb;

// ============================================================
// Enums
// ============================================================

enum AuthStatus : uint8 {
    OK = 0,
    InvalidCredentials,
    AccountBanned,
    ServerFull,
    VersionMismatch,
}

// ============================================================
// Common types
// ============================================================

struct Vec3 {
    x: float;
    y: float;
    z: float;
}

// ============================================================
// Client → Server messages
// ============================================================

// First message on the game-server control stream (C1). The server enforces
// protocol_version against its own CURRENT_PROTOCOL_VERSION and rejects a
// mismatch (or a missing handshake) with AuthStatus.VersionMismatch before
// honouring AuthRequest. The canonical version lives in two places that must
// move together: Protocol::CURRENT_PROTOCOL_VERSION (rts/Server/Protocol.h)
// and PROTOCOL_VERSION (client/src/core/connection.ts). Bump on any breaking
// change to this schema or the binary envelope formats; additive,
// default-valued fields do not require a bump.
table Handshake {
    protocol_version: uint16;
    client_version: string;
}

table AuthRequest {
    username: string;
    password_hash: string;      // bcrypt hash, not plaintext
    token: string;              // JWT for reconnection (alternative to user/pass)
    cached_defs_hash: string;   // W4: Hash of cached defs for skip on match
}

table PlayerCommand {
    sequence: uint32;           // Monotonic sequence number
    command_id: int16;          // CMD_MOVE, CMD_ATTACK, etc. (negative = build)
    squad_ids: [uint32];        // Target squads
    params: [float];            // Command parameters
    options: uint8;             // SHIFT=queue, ALT=override, etc.
    timeout_frames: uint32;     // 0 = no timeout
}

/// Multi-command batch sent atomically. Used for building drag-row /
/// drag-rectangle placement (N PlayerCommand entries, same builder
/// list, different positions), waypoint drag (CMD.INSERT + CMD.REMOVE
/// pair against the same unit), and any sequence where dropping or
/// reordering between entries would break intent. The server executes
/// the contained commands in order on the same sim tick — no
/// in-between state visible to other clients.
table PlayerCommandBatch {
    sequence: uint32;           // One sequence number for the whole batch
    commands: [PlayerCommand];
}

/// Client → Server: the local player's current selection. Sent debounced
/// (~50ms) on selection change. Server uses it to scope
/// UnitCmdDescsUpdate to only the units the player has selected, and as
/// the implicit target list for grouped commands when squad_ids is
/// empty. Sending an empty list is valid (no selection). The server
/// treats absent SelectionState as "selection unchanged" — resends are
/// idempotent.
table SelectionState {
    sequence: uint32;           // Monotonic, mirrors PlayerCommand.sequence space
    unit_ids: [uint32];         // Currently selected own-team units
}

table ViewportUpdate {
    viewport_id: uint8;
    center_x: float;
    center_z: float;
    width: float;
    height: float;
    rotation: float;            // Radians around Y axis
    zoom_level: float;
}

/// Client → Server: ask the server's IPathManager to compute a path.
/// Mirrors Spring's native `Spring.PathRequest(moveType, sx, sy, sz, ex, ey,
/// ez, radius)` Lua API but routed through the network. The server replies
/// with a `PathResponse` carrying the full waypoint list — typically on
/// the same sim tick, since `IPathManager::RequestPath` returns
/// synchronously for HAPFS and within ~1 tick for QTPFS. `request_id` is
/// client-assigned and must be unique per session; client-side widget
/// code keys path results by this id so concurrent requests don't
/// collide.
///
/// `move_type` matches `MoveDef::pathType` (resolved via
/// `UnitDefs[unitDefID].moveDef.id` on the client). Air units have no
/// move def — widgets must skip the request entirely rather than send a
/// 0 move type.
table PathRequest {
    request_id: uint32;
    start: Vec3;
    end: Vec3;
    /// Index into the server's MoveDefHandler (`MoveDef::pathType`).
    /// Different unit types take different routes — a kbot can climb
    /// hills a tank can't.
    move_type: uint32;
    /// Search radius around `end` — if the exact end is unreachable,
    /// accept any reachable point within this distance. Spring's
    /// default is 8.0 elmos.
    goal_radius: float;
}

/// Client → Server: abort a pending request. Sent on `widget:Shutdown`
/// or when a widget no longer cares about the result (e.g. the player
/// cancelled the build queue that triggered the path preview). Server
/// drops the request if it's still pending, ignores it otherwise.
/// Abandoned requests age out after 5 seconds server-side regardless.
table PathRequestCancel {
    request_id: uint32;
}

// ============================================================
// Standing orders (PLAN-orders.md "Standing Orders" section)
//
// High-level strategic directives that apply to *any* squad matching
// their conditions, not to specific units. The server's standing-order
// manager evaluates these periodically (every N sim ticks) and assigns
// matching idle squads to issue concrete CCommandAI orders. Player-
// issued direct commands always take precedence — a directly commanded
// squad leaves the standing-order pool until it becomes idle again.
// ============================================================

/// Type tag for a standing order. The `params: [float]` payload's
/// meaning is determined by this value:
///   DefendArea  → [x, y, z, radius]
///   PatrolRoute → [x1, y1, z1, x2, y2, z2, ...]    (N waypoints)
///   RallyPoint  → [x, y, z]
///   Fallback    → [x, y, z]
///   Reinforce   → [x, y, z, friendlyCountThreshold]
///   Screen      → [x1, y1, z1, x2, y2, z2]         (line endpoints)
///   SupplyRoute → [x1, y1, z1, x2, y2, z2]         (source, sink)
///   BuildBase   → [x, y, z, buildDefId, ...]       (loose schedule)
enum StandingOrderType : uint8 {
    DefendArea = 0,
    PatrolRoute = 1,
    RallyPoint = 2,
    Fallback = 3,
    Reinforce = 4,
    Screen = 5,
    SupplyRoute = 6,
    BuildBase = 7,
}

/// Squad-match conditions. A squad qualifies if it matches every
/// populated field. Zero-radius spatial filters are wildcards (the
/// `*_center` field is then ignored).
table StandingOrderConditions {
    /// Only consider squads with an empty command queue. Default true —
    /// directly commanded squads are off-limits for standing orders
    /// until they finish their queue.
    idle_only: bool = true;
    /// Allowed unit def IDs. Empty = any.
    squad_types: [uint16];
    /// "Must be inside this circle" filter on the squad's mid-position.
    within_radius_center: Vec3;
    within_radius_radius: float = 0;
    /// "Must be outside this circle" filter on the squad's mid-position.
    outside_radius_center: Vec3;
    outside_radius_radius: float = 0;
    /// Minimum aggregate squad strength (HP × count). 0 = no minimum.
    min_strength: float = 0;
    /// Capability tags the squad must have, e.g. "build", "repair",
    /// "scout". Resolution against unit defs is server-side and may be
    /// game-specific (Lua callback or unit-def category lookup).
    has_capabilities: [string];
    /// Org-group scope (macro-orders §4.2 — the A+C fusion). When non-zero,
    /// only squads that are members of this org group qualify; this is the
    /// field that draws a group-scoped directive from its own roster rather
    /// than the whole idle pool. 0 = any squad (classic condition/area
    /// scope). For a GroupDirective the server sets this from `group_id`.
    org_group: uint32 = 0;
}

/// Client → Server: create a new standing order owned by the
/// authenticated session's team. Server assigns an `order_id`,
/// broadcasts the resulting StandingOrderState to all sessions whose
/// allied-team view includes the owner team, and begins evaluation on
/// the next standing-order tick.
table StandingOrderCreate {
    sequence: uint32;           // Mirrors PlayerCommand.sequence space
    type: StandingOrderType;
    /// 0..100. Higher = wins ties when multiple orders compete for the
    /// same idle squad. See PLAN-orders.md "Standing Order Assignment
    /// Priority" for the full tie-break ladder.
    priority: uint8;
    params: [float];
    conditions: StandingOrderConditions;
    /// 0 = no expiry. Otherwise the order auto-removes itself this
    /// many sim frames after creation.
    expires_in_frames: uint32;
}

/// Client → Server: modify an existing standing order. Fields are
/// applied wholesale — the client must send the full conditions struct
/// even when only one field changed. `order_id` must match a standing
/// order owned by the authenticated session's team; the server rejects
/// cross-team edits with a 403 ServerError.
table StandingOrderUpdate {
    sequence: uint32;
    order_id: uint32;
    priority: uint8;
    params: [float];
    conditions: StandingOrderConditions;
    /// false = pause evaluation (order is preserved but no new squads
    /// are assigned, existing assignments are released).
    active: bool = true;
}

/// Client → Server: remove a standing order. Releases all assigned
/// squads back to the idle pool. Same team-ownership rules as Update.
table StandingOrderRemove {
    sequence: uint32;
    order_id: uint32;
}

// ============================================================
// Macro command & control (PLAN-macro-orders / PLAN-macro-directives)
//
// Ratified group model (Q-D-d, 2026-07-11): A+C hybrid — server-side org
// groups (Model A) + condition/area directives (Model C). v0 ships two
// echelons: squad + platoon/group. The army tier is *reserved in the
// schema but not surfaced*: the `echelon`/`parent_id` fields exist and are
// army-capable, but v0 emitters send only `echelon = Platoon` /
// `parent_id = 0`, and a v0 server REJECTS an army create or a non-zero
// parent (fail loud). Org-group ids come from their own counter + own
// table (Q-D-d §5.4), never the entity id stream.
// ============================================================

/// Command echelon. v0 emits/accepts only `Platoon`; `Army` is reserved
/// (schema-present, rejected on create until the tier ships).
enum Echelon : uint8 {
    Squad = 0,
    Platoon = 1,        // a.k.a. "group" — the only tier v0 surfaces
    Army = 2,           // reserved (post-v0)
}

/// Macro-directive type — a superset of StandingOrderType. Values 0..7
/// alias StandingOrderType 1:1 so a group-scoped classic order maps with
/// no translation; 8+ are the new platoon-level macro directives
/// (PLAN-macro-orders §2). DefendFront carries the polyline "front line"
/// shape — the first genuinely new order shape.
enum DirectiveType : uint8 {
    DefendArea = 0,
    PatrolRoute = 1,
    RallyPoint = 2,
    Fallback = 3,
    Reinforce = 4,
    Screen = 5,
    SupplyRoute = 6,
    BuildBase = 7,
    MoveFormation = 8,
    Assault = 9,
    Defend = 10,
    Overwatch = 11,
    Withdraw = 12,
    Escort = 13,
    DefendFront = 14,
}

/// Geometry of a directive's target. `params` on the directive is
/// interpreted per this shape (see the server-side decomposition docs):
///   Point    → [x, y, z]
///   Circle   → [x, y, z, radius]
///   Polygon  → [x1,y1,z1, x2,y2,z2, ...]         (ring, implicitly closed)
///   Polyline → [frontage/depth, x1,y1,z1, ...]   (the front line)
enum OrderShape : uint8 {
    Point = 0,
    Circle = 1,
    Polygon = 2,
    Polyline = 3,
}

/// Client → Server: create a server-side org group (Model A). Owned by
/// the authenticated session's team (team objects with player attribution,
/// not player ownership — macro-orders 2026-06-13 update). v0 rejects
/// `echelon = Army` and any non-zero `parent_id`.
table OrgGroupCreate {
    sequence: uint32;
    echelon: Echelon = Platoon;
    name: string;
    member_ids: [uint32];       // squad entity IDs to seed the roster
    parent_id: uint32;          // reserved: v0 rejects non-zero
}

/// Client → Server: mutate a group's roster / name. `add_ids` are pulled
/// out of any prior group first (a squad belongs to at most one platoon —
/// v0 rule). Empty `name` = leave name unchanged.
table OrgGroupUpdate {
    sequence: uint32;
    group_id: uint32;
    add_ids: [uint32];
    remove_ids: [uint32];
    name: string;
}

/// Client → Server: disband a group. Members become unassigned (and its
/// active directive, if any, is removed). Same team-ownership rule as the
/// standing-order edits.
table OrgGroupDisband {
    sequence: uint32;
    group_id: uint32;
}

/// Client → Server: create or update a macro directive. `directive_id == 0`
/// creates; non-zero updates in place. `group_id == 0` = condition-scoped
/// (classic area/standing directive); non-zero scopes the directive to that
/// group's roster (the A+C fusion). `conditions.org_group` is set
/// server-side from `group_id`. `params` is interpreted per `shape`.
/// The create path is the authority charge site for directive play
/// (PLAN-metalstorm-authority §A2) — hooked separately, not here.
table GroupDirective {
    sequence: uint32;
    directive_id: uint32;
    group_id: uint32;
    type: DirectiveType;
    priority: uint8;
    shape: OrderShape;
    params: [float];
    conditions: StandingOrderConditions;
    requested_strength: uint32;     // demand model; 0 = take what idles
    phases_json: string;            // optional chain (macro-orders §4.4); reserved in v0
    active: bool = true;
    expires_in_frames: uint32;
}

/// Client → Server: remove a macro directive. Releases its assigned squads.
table GroupDirectiveRemove {
    sequence: uint32;
    directive_id: uint32;
}

/// Client → Server: set a group's posture bundle (engagement / casualty
/// tolerance / reinforcement policy / area-weapon ROE — macro-orders §3).
/// Stored per group and streamed back in OrgGroupInfo. Posture *inheritance*
/// down the tree is post-v0; v0 stores + echoes the per-group setting.
table GroupPosture {
    sequence: uint32;
    group_id: uint32;
    posture_json: string;
}

table Ping {
    client_time: uint64;
}

table ChatSend {
    text: string;
    destination: uint8;         // 0=all, 1=allies, 2=spectators
}

/// Client → Server (game connection only): sent immediately before a
/// deliberate `disconnect()` so the server can distinguish *why* the client
/// is leaving. Optional — a client that disconnects without sending this
/// (crash, network drop, timeout) still produces a `PlayerRemoved` with the
/// server's own default reason (0). See `PlayerLeft.reason` /
/// `PlayerTeamEventItem.reason` for the shared reason enum.
/// PLAN-quickstart.md §3.3: the detach path (`gpDetach`) sends this with
/// reason=3 so PLAN-metalstorm-teams.md's `PlayerRemoved` consumer can tell
/// a parked/reconnecting player apart from one who actually quit.
table PlayerLeaveIntent {
    reason: uint8;
}

/// Forwarded `Spring.SendLuaRulesMsg` call from a client widget to the
/// server's synced LuaRules state. The data payload is delivered verbatim
/// to `gadget:RecvLuaMsg(msg, playerID)`. Bytes (not string) so embedded
/// nulls — which ZK widgets occasionally use as a separator — survive the
/// round-trip. PlayerID is resolved server-side from the authenticated
/// session, not trusted from the client.
table LuaRulesMsg {
    data: [uint8];
}

/// Forwarded `Spring.SendLuaUIMsg(msg, mode)` call from a client widget.
/// Unlike LuaRulesMsg (which feeds the server's synced LuaRules state), this
/// is a player→player LuaUI broadcast: the server relays it to every eligible
/// client as a `LuaUIMsgRelay` where it surfaces as
/// `widget:RecvLuaMsg(msg, playerID)`. `mode` selects the audience and is
/// resolved on the receiving end (Recoil `CLuaHandle::HandleLuaMsg`):
/// 0 = everyone, 'a' (97) = allies only, 's' (115) = spectators only. The
/// sending player also receives its own message back (faithful loopback).
/// Bytes (not string) so embedded nulls survive. PlayerID is resolved
/// server-side from the authenticated session, not trusted from the client.
table LuaUIMsg {
    data: [uint8];
    mode: uint8;
}

table Ack {
    last_received_seq: uint32;
}

table ReconnectRequest {
    token: string;
    last_snapshot_seq: uint32;
}

// ============================================================
// Lobby messages (client → server)
// ============================================================

table RoomCreate {
    name: string;
    map_id: string;
    game_id: string;
    max_players: uint8 = 8;
    password: string;           // empty = no password
}

table RoomJoin {
    room_id: uint32;
    password: string;
}

table RoomLeave {}

/// Convert from spectator to active player. Spectators can send this
/// to request joining the game as a rostered player (assigned to a team).
/// If the room is full (non-spectator player count >= maxPlayers), the
/// request is rejected. If accepted, the spectator transitions to a
/// player with team assignment (auto-assigned or specified by team field),
/// and the room broadcasts the state change via RoomStateUpdate.
table RoomEnlist {
    team: uint8 = 255;      // 255 = auto-assign next available team
}

table RoomTeamSelect {
    team: uint8;
}

table RoomReady {
    ready: bool;
}

table RoomKick {
    player_id: uint32;
}

table RoomStartGame {}

/// Host-only request to end a running game. Terminates the spring-server
/// subprocess for this room; the room transitions to Ended when the
/// process is reaped by the lobby health-check loop. Ignored if the
/// sender is not the room host or the room is not in an active state.
table RoomEndGame {}

/// Host-only request to close (delete) the entire room. Kills the
/// game subprocess if one is still running, removes the room from
/// the lobby's room list, and leaves every member in the browser
/// view. Symmetric with RoomCreate — once the close broadcast goes
/// out, the room id no longer resolves. Rejected if the sender is
/// not the current room host.
table RoomCloseRoom {}

/// Host-only request to add an AI player to a team slot in the current
/// room. `ai_id` must match one of the ids the server returned in its
/// most recent AIListUpdate; unknown ids are rejected. Ignored if the
/// sender is not the room host or the room is past the Filling state.
table RoomAddAI {
    ai_id: string;
    team: uint8;
}

/// Host-only request to remove an AI slot from the current room by
/// its index in the RoomStateUpdate.ai_slots vector. Ignored if the
/// sender is not the room host.
table RoomRemoveAI {
    slot_index: uint8;
}

/// Host-only request to re-assign an AI slot to a different team.
/// Targets the slot by its index in the RoomStateUpdate.ai_slots
/// vector. Ignored if the sender is not the room host or the index
/// is out of range. Does not affect the slot's start position.
table RoomSetAITeam {
    slot_index: uint8;
    team: uint8;
}

/// Assign a map start position to a player or AI slot in the current
/// room. Start positions are indices into the map's start_positions
/// array (see MapInfo) — the game server uses them to decide where
/// each team spawns at game start.
///
/// Addressing rules:
///   - target_player_id = 0 and target_ai_slot = -1: "my own slot"
///     (any player can do this; assigns to the sender).
///   - target_player_id > 0: target that player's slot. Host only.
///   - target_ai_slot >= 0: target that AI slot. Host only.
///   - pos_index = -1 clears the assignment (will be auto-filled
///     at game start).
///
/// The server rejects the request if `pos_index` is already held by
/// another slot in the same room, or is out of range for the map.
table RoomSetStartPos {
    target_player_id: uint32 = 0;
    target_ai_slot: int8 = -1;
    pos_index: int8;
}

/// Request the server's current list of available AI plugins for
/// the current room's game. Response is an AIListUpdate. Any client
/// can issue this (not host-only) so team-picking UIs can display
/// AI metadata without waiting for a slot to exist.
table AIListRequest {}

/// Request the server's list of discovered games under data/games.
/// Response is a GameListUpdate. Sent by the lobby UI on first
/// login so the "create game" dropdown can be populated.
table GameListRequest {}

// ============================================================
// Logging + Debug messages (shared between client/server/tools)
// ============================================================

/// A single structured log entry. Used in LogIngest (inbound)
/// and LogBatch (outbound streaming to subscribers).
table LogEntryMsg {
    id: uint64;
    timestamp: uint64;
    level: uint8;
    section: string;
    scope: string;
    process: string;
    message: string;
    frame: uint32;
}

/// Any process → log server: batch of log entries for ingestion.
table LogIngest {
    entries: [LogEntryMsg];
}

/// Subscribe to log streaming from the log server.
table LogSubscribe {
    room_id: uint32;
    min_level: uint8;
    section_filter: string;
    scope_filter: string;
}

/// Unsubscribe from log streaming.
table LogUnsubscribe {}

/// Log server → subscriber: streamed batch of log entries.
table LogBatch {
    room_id: uint32;
    entries: [LogEntryMsg];
    latest_id: uint64;
}

/// Execute a command in a specific scope (Lua context, lobby, server).
table ConsoleCommand {
    scope: string;          // "LuaRules", "LuaGaia", "LuaAI:basic_ai", "lobby", "server"
    command: string;        // Lua code or built-in command
    request_id: uint32;
}

/// Game server has finished boot and started ticking. Sent from
/// game server to lobby over the admin WS connection. Triggers
/// room state transition from Loading → Active.
table GameStarted {
    frame: uint32;
}

/// Game server is about to restart itself (execvp). Clients should
/// reset all game state and reconnect on the same port.
table GameRestarting {
}

/// Response to a ConsoleCommand.
table ConsoleResponse {
    request_id: uint32;
    scope: string;
    success: bool;
    output: string;
    level: uint8;
}

// Union of all client→server message types
union ClientPayload {
    Handshake,
    AuthRequest,
    PlayerCommand,
    ViewportUpdate,
    Ping,
    ChatSend,
    Ack,
    ReconnectRequest,
    RoomCreate,
    RoomJoin,
    RoomLeave,
    RoomEnlist,
    RoomTeamSelect,
    RoomReady,
    RoomKick,
    RoomStartGame,
    RoomEndGame,
    RoomAddAI,
    RoomRemoveAI,
    AIListRequest,
    GameListRequest,
    RoomSetStartPos,
    RoomCloseRoom,
    RoomSetAITeam,
    LogIngest,
    LogSubscribe,
    LogUnsubscribe,
    ConsoleCommand,
    LuaRulesMsg,
    PlayerCommandBatch,
    SelectionState,
    PathRequest,
    PathRequestCancel,
    StandingOrderCreate,
    StandingOrderUpdate,
    StandingOrderRemove,
    LuaUIMsg,
    PlayerLeaveIntent,
    OrgGroupCreate,
    OrgGroupUpdate,
    OrgGroupDisband,
    GroupDirective,
    GroupDirectiveRemove,
    GroupPosture,
}

table ClientMessage {
    payload: ClientPayload;
}

// ============================================================
// Server → Client messages
// ============================================================

table AuthResponse {
    status: AuthStatus;
    token: string;              // JWT session token (on success)
    /// The authenticated DB **account** id — stable across games, rooms and
    /// reconnects. NOT the sim player number; see `player_num` below and the
    /// identity contract in PLAN-native-ui.md §3.3.
    player_id: uint32;
    message: string;            // Error description (on failure)
    /// Team id assigned by the lobby for this session (game server
    /// only — on the lobby this stays at 0). -1 means unassigned /
    /// spectator. The client stores this so it can scope unit
    /// rendering, command validation, and UI chrome to "my team".
    team: int8 = -1;
    /// Role: "admin", "player", or "spectator". Used by the client to
    /// show/hide command UI and display the Enlist button for spectators.
    role: string;
    /// Cache key for this game's UnitDefs/WeaponDefs FlatBuffer
    /// payloads. Hash of (gameId, version, modOptions). Client uses
    /// it to construct the fetch URL:
    ///   /api/games/data/{gameId}/cache/defs/{key}/unitdefs.bin
    ///   /api/games/data/{gameId}/cache/defs/{key}/weapondefs.bin
    /// The path is content-addressed so the browser can cache the
    /// response with `immutable` for the game's full lifetime.
    /// Empty if the server has no defs (lobby auth, or pre-Init).
    defs_cache_key: string;
    /// Spring's `playerNum` for this session — the **sim** player id, assigned
    /// per game server in connect order (AI virtual players take the low
    /// numbers, registered before any client connects). This is what every
    /// synced surface keys on: `gadget:PlayerAdded(playerID)`,
    /// `Spring.GetPlayerList()`, `UnitCommandEvent.player_id`, `LuaUIMsg
    /// .player_id`, and Metalstorm's per-player authority pool rulesParam
    /// `authority_player_<playerNum>`. It is unrelated to `player_id` above:
    /// the two coincide only by accident on low-id dev accounts, which is what
    /// hid this for so long (PLAN-endtoend.md D3).
    /// -1 on the lobby, which has no sim.
    player_num: int32 = -1;
}

table EntityCreate {
    entity_id: uint32;
    def_id: uint16;
    owner_team: uint8;
    position: Vec3;
    heading: uint16;
    health: uint16;
}

table EntityDestroy {
    entity_id: uint32;
    destruction_type: uint8;    // Normal, explode, fade, etc.
    position: Vec3;
}

/// Sensor type ordering matches `Spring.GetUnitSensorRadius`'s `type`
/// argument and Recoil's internal CLosHandler subsystems. Used by
/// EntitySensorUpdate so the client knows which radius changed.
enum SensorType : uint8 {
    Los = 0,
    AirLos,
    Radar,
    Sonar,
    Seismic,
    RadarJammer,
    SonarJammer,
}

/// Per-unit sensor radius override. Emitted whenever
/// `Spring.SetUnitSensorRadius` mutates a sensor on the server so the
/// client widget worker can refresh range-circle widgets immediately
/// instead of waiting for an entity-state snapshot (snapshots don't
/// re-stream the unit def — they have no field for the override).
/// `radius` is in elmos, matching `Spring.GetUnitSensorRadius`'s
/// return value. A radius of 0 means the sensor was disabled.
table EntitySensorUpdate {
    entity_id: uint32;
    sensor_type: SensorType;
    radius: float;
}

// Combat event result
enum CombatResult : uint8 {
    Hit = 0,
    Miss,
    Blocked,       // shield/armour absorbed
    Kill,          // target destroyed
    Unknown,       // visibility-filtered: viewer sees the shots but not the outcome
}

table CombatEvent {
    attacker_id: uint32;
    target_id: uint32;
    weapon_def_id: uint16;
    result: CombatResult;
    damage: float;
    position: Vec3;            // Impact point
}

/// Metalstorm statistical combat (Model 1) per-volley outcome
/// (PLAN-metalstorm-combat-resolution.md §2.3 / PLAN-macro-combat.md §3).
/// One per squad-volley, NOT per round — the client invents `rounds`
/// cosmetic tracers/impacts from a single event. Visibility-filtered
/// per session in StateStreamer::BroadcastCombatEvents:
///   - viewer sees the attacker  -> full outcome (Hit/Miss, damage, attacker_id)
///   - viewer owns the target but can't see the attacker -> result Unknown,
///     damage 0, attacker_id 0, plus a counterbattery radar-blip reveal
///     (reveal_attacker + reveal_pos, Q-D-c ANSWERED 2026-07-19)
///   - viewer sees only the target (neither owner nor attacker-LOS) -> Unknown,
///     no reveal
///   - viewer sees neither -> not sent
table VolleyOutcome {
    attacker_id: uint32;          // firing unit; 0 if hidden from this viewer
    weapon_def_id: uint16;
    target_id: uint32;            // victim unit; 0 if hidden from this viewer
    target_pos: Vec3;             // impact position (FX + squad casualty hint)
    resolve_frame: uint32;        // fire_frame + flight time (foreknown outcome)
    result: CombatResult = Hit;   // Hit / Miss / Unknown (visibility-filtered)
    damage: uint16;               // aggregate; 0 for Unknown / miss
    rounds: uint8 = 1;            // cosmetic shot count for client tracer fan-out
    team: uint8 = 255;            // attacker team (FX tint / ally audio); 255 = hidden
    /// Counterbattery reveal (Q-D-c). True only for the victim's team when
    /// they cannot see the attacker: the client drops a radar blip at
    /// `reveal_pos` (the attacker's firing position) so statistical artillery
    /// is counterable. Never set for viewers who can already see the attacker.
    reveal_attacker: bool = false;
    reveal_pos: Vec3;             // attacker firing position (only when reveal_attacker)
    /// Attacker morale posture, a derived proxy (morale = clamp(hp% - 10, 0, 100)):
    /// 0 = normal, 1 = retreating-while-firing (morale < 10), 2 = panicking
    /// (morale == 0). Lets the client show a retreat/panic indicator. Only
    /// meaningful when attacker_id != 0 (attacker visible).
    attacker_posture: uint8 = 0;
}

/// Metalstorm damage-field lifecycle (Model 3 — area bombardment, C6,
/// PLAN-metalstorm-combat-resolution.md §4). A field is an area that applies
/// `intensity` damage/sec on a fixed cadence for `duration` frames. The SIM
/// owns all damage (units inside take it via DoDamage). The client receives
/// only these Created/Removed lifecycle events and INVENTS the barrage FX
/// (procedural shell arcs + impacts scattered in the area at the given
/// cadence) — no per-shell wire traffic. Visibility-filtered per session in
/// StateStreamer::BroadcastCombatEvents by area overlap with the viewer's
/// known space (own-team fields always shown).
enum DamageFieldEventKind : uint8 {
    Created = 0,   // a field appeared — start inventing barrage FX
    Removed = 1,   // field expired or was cancelled — stop the FX
}

enum DamageFieldShape : uint8 {
    Circle = 0,    // center + radius
    Rect = 1,      // center + (half_x, half_z) axis-aligned box
}

table DamageFieldEvent {
    field_id: uint32;
    kind: DamageFieldEventKind;
    shape: DamageFieldShape;
    center: Vec3;               // field center (y = ground sample at create)
    radius: float;             // circle radius, or rect half-extent along x
    half_z: float = 0;         // rect half-extent along z (0 for a circle)
    weapon_def_id: uint16;     // for FX flavour (CEG lookup); 0 = generic
    intensity: float;          // damage/sec — client scales impact density
    cadence: uint16 = 15;      // frames between damage ticks (FX pulse rate)
    duration: uint32;          // remaining frames at creation (0 on Removed)
    team: uint8 = 255;         // owner team (FX tint); 255 = neutral/none
}

table GameEvent {
    topic: string;
    frame: uint32;
    entity_id: uint32;
    position: Vec3;
    payload: [uint8];           // Opaque event payload
}

/// Why a projectile died — drives the impact VFX the client plays.
enum ProjectileImpactKind : uint8 {
    Terrain = 0,        // ground / water hit
    Unit = 1,           // hit a unit (target_id is the unit)
    Feature = 2,        // hit a feature (target_id is the feature)
    Shield = 3,         // absorbed by a shield (target_id is the shield-host)
    SelfDetonate = 4,   // ttl expired / self-explode
    Intercepted = 5,    // killed by an interceptor weapon
    Other = 6,          // catch-all (out of bounds, lua-killed, etc.)
}

/// Why a trajectory event was emitted. Lets the client pick a fitting visual
/// (sparks for a bounce, a re-aim puff for steering, etc.).
enum ProjectileTrajectoryReason : uint8 {
    Bounce = 0,
    Steered = 1,
    InterceptRetarget = 2,
}

/// Projectile creation event. Sent once per projectile, when the server
/// instantiates it. The client uses this to spawn a local visual that
/// runs the same ballistic / hit-scan motion the simulation runs — no
/// per-frame position stream is needed for short-lived projectiles.
table ProjectileFiredEvent {
    proj_id: uint32;
    weapon_def_id: uint16;
    owner_id: uint32;          // firing unit (0 if unknown)
    team: uint8;
    pos: Vec3;                 // launch position (muzzle)
    vel: Vec3;                 // initial velocity (elmos / sim frame)
    target_pos: Vec3;          // intended impact / aim point (for hit-scan endpoints, ttl computation)
    target_id: uint32;         // tracked unit id, 0 if ground/feature
    ttl: int16;                // sim frames until self-detonate (0 = unbounded)
    gravity: float;            // per-frame gravity (0 for direct/laser/missile-with-tracker)
    /// Hit-scan flag — when true the client renders a beam from pos→target_pos
    /// for one tick (or the weapon's beam duration) and discards.
    hitscan: bool = false;
}

/// Projectile death event. Sent exactly once per projectile, when it
/// collides, expires, or is intercepted. Triggers explosion VFX +
/// removes the local projectile entry.
table ProjectileImpactEvent {
    proj_id: uint32;
    pos: Vec3;
    impact_kind: ProjectileImpactKind;
    target_id: uint32;         // hit unit/feature/shield-host (0 for terrain)
    /// Owner-team id — used by the per-session LOS filter so a client
    /// always sees impacts from its own/allied projectiles, even if the
    /// impact happens in fog of war.
    team: uint8 = 0;
    /// Weapon def driving the explosion. Populated for both projectile
    /// impacts (matches `proj_id`'s weapon) and free-floating
    /// explosions like unit death / self-destruct (where no live
    /// projectile exists for the client to look up). 0 = "unknown,
    /// look up via proj_id or fall back to generic VFX".
    weapon_def_id: uint16 = 0;
}

/// Trajectory change event. Sent only when the projectile bounces,
/// is steered onto a new target, or has its motion overridden. The
/// client rewrites its local projectile's pos+vel at the given frame.
table ProjectileTrajectoryEvent {
    proj_id: uint32;
    pos: Vec3;
    vel: Vec3;
    reason: ProjectileTrajectoryReason;
    /// Owner-team id — see ProjectileImpactEvent.team. Lets the per-session
    /// filter keep ally trajectory updates flowing through fog of war.
    team: uint8 = 0;
}

/// What produced a sound. Lets the client resolve `source_def_id` against
/// the right def cache (unit defs vs weapon defs vs features) and lets
/// synced filters target rules per-source-type.
enum SoundSourceKind : uint8 {
    Unit = 0,
    Weapon = 1,
    Feature = 2,
    Global = 3,
}

/// Mix channel for a sound emission. Matches Recoil's five named
/// channels (`rts/System/Sound/ISoundChannels.h`). Each channel has
/// an independent volume + enable state on the client. The emitter
/// (server combat code, widget Spring.PlaySoundFile, etc.) picks the
/// channel — the SoundItem itself does NOT carry a channel field, to
/// preserve Recoil parity. Defaults to `General` when unspecified.
enum SoundChannel : uint8 {
    General = 0,
    Battle = 1,
    UnitReply = 2,
    UserInterface = 3,
    BGMusic = 4,
}

/// A single sound emission. The server pushes one of these whenever a
/// weapon fires, a projectile impacts, a unit dies, etc. The client
/// resolves `(source_kind, source_def_id, sound_id)` against the matching
/// def's `sounds` array, decodes the audio buffer (cached), and plays
/// through the 96-voice pool with HRTF panning at `position`.
table SoundEvent {
    sound_id: uint16;        // index into the def's sounds array
    source_def_id: uint16;   // unit def id, weapon def id, or feature def id
    source_kind: SoundSourceKind;
    position: Vec3;
    volume: float = 1.0;     // 0–1, pre-attenuation, multiplied with SoundRef.volume
    pitch: float = 1.0;      // playback rate, multiplied with SoundRef.pitch
    /// Eviction priority when the 96-voice pool is full. Higher wins.
    /// Set by the server when no SoundItem entry is available; if the
    /// client resolves a SoundItem with its own `priority`, that
    /// overrides this value (per the SoundItem-resolution rules in
    /// PLAN-audio.md).
    priority: uint8 = 128;
    /// Owner team — used by the per-session LOS filter so ally sounds
    /// remain audible through fog of war. 255 = no team / global sound.
    team: uint8 = 255;
    /// Mix channel. Server-side emitters pick this based on context:
    /// CWeapon::Fire and projectile impacts -> Battle; selection /
    /// order-ack paths -> UnitReply; UI -> UserInterface; the music
    /// state machine -> BGMusic; everything else (default) -> General.
    channel: SoundChannel = General;
}

/// Combat-intensity state used by the server's music state machine.
/// Transitions are sampled from a sliding window of CombatEvent
/// activity and broadcast to every client (so spectators stay in
/// sync with the players). Client-side playlists per state are
/// authored in `gamedata/sounds.lua` (entries named `music_<state>_N`)
/// or an optional `gamedata/music.lua` Music table.
enum MusicState : uint8 {
    Peace = 0,
    Tension = 1,
    Battle = 2,
    Victory = 3,
    Defeat = 4,
}

/// Music-state transition event. Broadcast to all clients (not per-
/// viewport) in the same GameEventBatch as combat / sound events.
/// `fade_ms` is the crossfade duration the client should use when
/// switching to a track in the new state's playlist; defaults to 2 s
/// for in-game transitions, 500 ms for victory / defeat stings.
table MusicEvent {
    state: MusicState;
    fade_ms: uint16 = 2000;
}

/// Seismic ping — emitted server-side when a moving unit's seismic
/// signature exceeds the local seismic-listener radius for an ally
/// team. Carries the (already deceived) world position the listener
/// "hears", not the unit's true position. The unit id and unit-team
/// are NOT included on the wire: seismic pings are intentionally
/// anonymous (the whole point is "something is moving over there").
/// `ally_team` is the listener team — server filters per-session so a
/// client only ever receives pings for its own ally team.
table SeismicPing {
    pos: Vec3;
    strength: float;
    ally_team: int16;
}

table GameEventBatch {
    frame: uint32;
    events: [GameEvent];
    combat_events: [CombatEvent];
    /// Projectile lifecycle events. Sent each tick they occur; the
    /// per-projectile state stream (envelope 0x04) is no longer used.
    projectile_fired: [ProjectileFiredEvent];
    projectile_impacts: [ProjectileImpactEvent];
    projectile_trajectories: [ProjectileTrajectoryEvent];
    /// Per-tick sound emissions. Already visibility-filtered for this
    /// session (see SoundEventCollector / per-client snapshot filter).
    sounds: [SoundEvent];
    /// Per-tick seismic pings. Visibility-filtered server-side: each
    /// session only receives pings whose `ally_team` matches its own.
    seismic_pings: [SeismicPing];
    /// Music-state transitions emitted by the server's intensity
    /// tracker. Broadcast to every client (no per-viewport filtering)
    /// so spectators stay in sync. Usually empty; only populated on
    /// the tick when a state change fires.
    music_events: [MusicEvent];
    /// Metalstorm statistical-combat per-volley outcomes (Model 1). Already
    /// visibility-filtered for this session. Empty for ported games (ZK/BAR
    /// use the projectile path); populated only when statistical weapons fire.
    /// See VolleyOutcome. Appended last for FlatBuffers field-id stability.
    volley_outcomes: [VolleyOutcome];
    /// Metalstorm damage-field lifecycle events (Model 3, C6). Empty for
    /// ported games; populated only when a game creates/expires a barrage
    /// field. Appended last for FlatBuffers field-id stability. See
    /// DamageFieldEvent.
    damage_fields: [DamageFieldEvent];
}

table ResourceUpdate {
    team: uint8;
    metal: float;
    max_metal: float;
    energy: float;
    max_energy: float;
    metal_income: float;
    energy_income: float;
    // Per-second pull (committed expense by builders/weapons), expense
    // (actually drawn last frame), share slack (storage headroom before
    // share-threshold spillage), and excess (resources wasted last
    // frame because storage was full). All are per-second rates derived
    // from the previous-second accumulators (CTeam::resPrev*).
    metal_pull: float = 0.0;
    energy_pull: float = 0.0;
    metal_expense: float = 0.0;
    energy_expense: float = 0.0;
    metal_share: float = 0.0;
    energy_share: float = 0.0;
    metal_sent: float = 0.0;
    energy_sent: float = 0.0;
    metal_received: float = 0.0;
    energy_received: float = 0.0;
    metal_excess: float = 0.0;
    energy_excess: float = 0.0;
}

table Pong {
    client_time: uint64;        // Echoed back
    server_time: uint64;
}

table ChatReceive {
    sender_id: uint32;
    sender_name: string;
    text: string;
    destination: uint8;
}

table GameInfo {
    map_id: string;
    game_id: string;
    game_speed: float;
    frame: uint32;
    paused: bool;
    /// Current wind vector (elmos/sec). y is always near 0 in practice.
    /// Updated server-side every 15 game-seconds; client is free to
    /// interpolate between snapshots if visual smoothness matters.
    wind_x: float = 0;
    wind_y: float = 0;
    wind_z: float = 0;
    /// |wind_vec| — what Spring.GetWind / wind generators read.
    wind_strength: float = 0;
    /// Map's tidal energy multiplier; constant per map but cheaper to
    /// piggyback here than to add a one-shot message.
    tidal_strength: float = 0;
    /// True when the active game ships with Lua content authored
    /// against Spring's legacy left-handed coord system. Clients pipe
    /// this flag into `lua-spring-api.ts` / `lua-gl-bridge.ts` so the
    /// LH-style values legacy widgets/gadgets expect bridge back to
    /// the RH internal state. Defaults to false for RH-native games.
    /// See PLAN-coordinate-system.md and docs/coordinate-system.md.
    legacy_coord_system: bool = false;
    /// The engine's global unit-ID ceiling — `unitHandler.MaxUnits()` =
    /// Σ active teams of their per-team cap (the `maxunits` modoption clamped
    /// to MAX_UNITS / numTeams). Immutable for the game-server's lifetime.
    /// The client's `Game.maxUnits` MUST equal this exactly: it's the
    /// unit/feature ID-space boundary order params pack against
    /// (`featureID + maxUnits`), so a mismatch silently misdecodes every
    /// feature-targeted reclaim/repair/resurrect order. 0 = not yet known.
    /// See PLAN-bar.md (Game-table maxUnits thread).
    max_units: uint32 = 0;
    /// True ONLY in the game-over broadcast (StateStreamer's last-team-standing
    /// fallback, or a game gadget's `Spring.GameOver(winners)`). The client
    /// shows the game-over overlay + fires `widget:GameOver` on THIS flag, never
    /// on `paused` — a normal in-game pause must not end the game. Defaults false
    /// for every ordinary GameInfo (auth snapshot, periodic refresh).
    game_over: bool = false;
    /// W4: Content hash of all game defs (units + weapons). Client can skip
    /// re-downloading defs on reconnect if this matches cached hash.
    defs_hash: string;
    /// Winning allyteam IDs, as passed to `Spring.GameOver(allyTeamID1, …)`.
    /// Empty when the result is undecided (e.g. host drop) or on a fallback win
    /// with no ally mapping. Only meaningful when `game_over = true`. Mirrors
    /// Recoil's `GameOver(winningAllyTeams)` callin argument.
    winning_ally_teams: [ubyte];
}

/// One team's start position, in RH-canonical elmos (the same convention
/// as entity-state positions — the engine's `FlipPosZ` is a no-op). `valid`
/// mirrors `CTeam::HasValidStartPos()`. Lets the in-game LuaUI worker answer
/// `Spring.GetTeamStartPosition` (16× BAR widget callers, plus ZK).
struct TeamStartPos {
    team: int16;
    ally_team: int16;
    x: float;
    y: float;
    z: float;
    valid: bool;
}

/// One ally team's start box in elmos (xmin, zmin, xmax, zmax) — matches
/// `Spring.GetAllyTeamStartBox`. NB the current headless flow never calls
/// `Spring.SetAllyTeamStartBox`, so every ally team carries the default
/// full-map box (0,0 → mapWidth,mapHeight); the field is streamed faithfully
/// so a game that *does* set boxes works without a second wire change.
struct AllyStartBox {
    ally_team: int16;
    xmin: float;
    zmin: float;
    xmax: float;
    zmax: float;
}

/// Team start positions + ally start boxes. Sent reliably to each client
/// on auth (initial values) and re-broadcast once after GameStart (final
/// values, since gadgets like BAR's game_initial_spawn.lua relocate teams
/// via Spring.SetTeamStartPosition during the start sequence). Tiny and
/// infrequent, so it is its own message rather than bloating per-second
/// GameInfo.
table TeamStartInfo {
    teams: [TeamStartPos];
    boxes: [AllyStartBox];
}

/// One player- or team-status change, mirroring the matching Recoil
/// eventHandler callins. `kind` selects which LuaUI callin the widget worker
/// fires; `id` is a playerID (kinds 0-2) or teamID (kind 3); `reason` carries
/// the PlayerRemoved reason (0 otherwise). Streamed as a per-tick batch so a
/// team death (which demotes every member player to spectator) coalesces its
/// PlayerChanged + TeamDied events into one message.
struct PlayerTeamEventItem {
    /// 0 = PlayerChanged, 1 = PlayerAdded, 2 = PlayerRemoved, 3 = TeamDied.
    kind: uint8;
    /// PlayerRemoved reason (0=quit, 1=kicked, 2=timeout, 3=detach — parked,
    /// may reconnect); 0 for other kinds.
    reason: uint8;
    /// playerID for kinds 0-2, teamID for kind 3.
    id: uint32;
}

/// Batch of player/team status changes for one sim tick. Reliable. Drives
/// widget:PlayerChanged / PlayerAdded / PlayerRemoved / TeamDied on the
/// client LuaUI worker (the server's own synced Lua gets these via
/// eventHandler directly; this carries them across the unsynced boundary).
table PlayerTeamEventBatch {
    events: [PlayerTeamEventItem];
}

/// One team-statistics history entry, mirroring Recoil's `TeamStatistics`
/// struct (rts/Sim/Misc/TeamStatistics.h). The server accumulates these in
/// `CTeam::statHistory` — a new entry is finalised every
/// `TeamStatistics::statsPeriod` (15) game-seconds, with the final (back())
/// entry the live, still-accumulating one. Field order/units match the table
/// `Spring.GetTeamStatsHistory` returns. `frame` is the sim frame at which the
/// entry was finalised (for the live tail it is the *future* boundary frame;
/// the worker overrides it to the current frame, as Recoil does).
struct TeamStatsEntry {
    frame: int32;
    metal_used: float;
    energy_used: float;
    metal_produced: float;
    energy_produced: float;
    metal_excess: float;
    energy_excess: float;
    metal_received: float;
    energy_received: float;
    metal_sent: float;
    energy_sent: float;
    damage_dealt: float;
    damage_received: float;
    units_produced: int32;
    units_died: int32;
    units_received: int32;
    units_sent: int32;
    units_captured: int32;
    units_out_captured: int32;
    units_killed: int32;
}

/// Incremental stats-history update for one team. `base_index` is the 0-based
/// position of `entries[0]` within the team's full `statHistory`; the client
/// overwrites slots `[base_index ..]` so the previously-live tail (re-sent once
/// it finalises) is replaced and the new live tail appended. In the steady
/// state `entries` is just the single live tail (its resource/damage totals
/// accumulate every frame); when a 15s boundary finalises an entry the next
/// update carries both the now-final entry and the new tail.
table TeamStatsHistoryItem {
    team_id: uint32;
    base_index: uint32;
    entries: [TeamStatsEntry];
}

/// Per-second batch of stats-history deltas for every active team. Reliable.
/// Streamed unfiltered (like TeamStartInfo / PlayerTeamEventBatch); the worker
/// applies Recoil's alliance gate (`Spring.GetTeamStatsHistory` only returns
/// non-allied teams once the game is over) at the read site.
table TeamStatsHistoryBatch {
    teams: [TeamStatsHistoryItem];
}

/// One game modoption (always a string key→value, exactly as the lobby
/// passed it to the game server via `--modoption key=value` and as the
/// synced side stores it in `CGameSetup::GetModOptions`). Values stay
/// strings on the client too — Recoil's `Spring.GetModOptions()` pushes
/// `lua_pushsstring(value)` and callers `tonumber()` numeric options
/// themselves (LuaSyncedRead.cpp `PushAllOptions`).
table ModOption {
    key: string;
    value: string;
}

/// The active game's modoptions. Sent reliably, once, per-client on auth
/// (modoptions are immutable for the life of a game server, so there is no
/// re-broadcast — a late joiner gets them on its own auth). Feeds the worker
/// `liveState.modOptions` so the unsynced LuaUI `Spring.GetModOptions()`
/// returns the same set the synced gadgets and the defs-cache key already see.
table GameModOptions {
    options: [ModOption];
}

table ReconnectResponse {
    status: uint8;              // 0=OK (delta), 1=FULL_SYNC
}

table ServerError {
    code: uint16;
    message: string;
}

/// Broadcast to remaining clients when a player disconnects from
/// the game server. The game's Lua scripts decide what happens next
/// (kill units, pause, hand to AI, etc.) — this message is purely
/// informational so clients can update their UI.
table PlayerLeft {
    /// DB **account** id, like `AuthResponse.player_id` — not the sim
    /// playerNum. Anything that needs to key a departure against synced state
    /// should read the `PlayerRoster` broadcast that accompanies this message
    /// (the leaver's entry flips to `active = false`).
    player_id: uint32;
    username: string;
    team: int8;
    /// 0 = voluntary quit, 1 = kicked, 2 = connection timeout, 3 = detach
    /// (worker parked client-side; may reconnect — PLAN-quickstart.md §3.3)
    reason: uint8;
}

/// One row of the game server's authoritative player roster.
///
/// Roster entries exist for every `CPlayer` in the server's `playerHandler`:
/// humans (commanding and spectating) and AI virtual players alike. Metalstorm
/// deliberately registers each AI slot as a real player so it pays authority
/// through the same gate as a human (PLAN-metalstorm-ai.md §1) — a departure
/// from stock Spring, where a SkirmishAI is not a player. `is_ai` is how a
/// client tells the two apart.
table PlayerEntry {
    /// Spring's `playerNum`. THE sim-side identity — same value as
    /// `AuthResponse.player_num`, `UnitCommandEvent.player_id`, and the
    /// `<playerID>` in Metalstorm's `authority_player_<id>` /
    /// `score_<id>_earned` rulesParams.
    player_num: int32;
    name: string;
    /// Sim team id. -1 for a spectator (no team).
    team: int16 = -1;
    /// The team's ally team. -1 when the team is unknown / unassigned.
    ally_team: int16 = -1;
    spectator: bool = false;
    /// True for an AI virtual player (see the table comment).
    is_ai: bool = false;
    /// False once the player has disconnected. Entries are kept rather than
    /// removed so a scoreboard can still name a player who dropped.
    active: bool = true;
    /// DB account id for a human — the value `AuthResponse.player_id` carries
    /// for that session. 0 for AI virtual players, which have no account.
    account_id: uint32 = 0;
}

/// The full player roster, sent reliably to each client on auth and
/// re-broadcast to everyone whenever it changes (join, reconnect, leave).
/// Always complete, never a delta — it is a handful of rows and a client that
/// missed one broadcast would otherwise be permanently wrong.
///
/// This is the only place the client learns player *names* and which
/// playerNums exist; the lobby room roster is not a substitute (it has no AI
/// entries, no sim playerNums, and is frozen at game start).
table PlayerRoster {
    players: [PlayerEntry];
}

// ============================================================
// Lobby messages (server → client)
// ============================================================

enum RoomState : uint8 {
    Configuring = 0,
    Filling,
    ReadyCheck,
    Loading,
    Active,
    Ended,
}

table RoomPlayerInfo {
    player_id: uint32;
    username: string;
    team: uint8;
    ready: bool;
    is_spectator: bool;
    is_host: bool;
    /// Map start position index assigned to this player. -1 means
    /// "unassigned, auto-fill at game start". Indices refer to the
    /// map's `start_positions` array (see MapInfo). Positions are
    /// exclusive within a room: no two slots can hold the same
    /// index at the same time.
    start_pos: int8 = -1;
}

/// An AI player occupying a slot in a room's roster. Unlike human
/// players, AI slots have no playerId / clientId — they only exist
/// on the lobby server until the game starts, at which point the
/// game server spawns an AIRuntimePool entry for each slot.
table RoomAISlot {
    ai_id: string;          // stable id (folder name), e.g. "null"
    display_name: string;   // human-readable label from ai.config
    team: uint8;
    /// Same semantics as RoomPlayerInfo.start_pos — -1 means the
    /// lobby will auto-assign at game start.
    start_pos: int8 = -1;
    /// Optional personality/difficulty profile name for AI plugins that
    /// support one (e.g. Metalstorm's strategos: "aggressive", "caretaker")
    /// — PLAN-metalstorm-ai.md §10 task 6. Empty = no override. Opaque to
    /// the engine; set via POST /api/rooms/ai/profile.
    profile: string;
}

/// One available AI plugin, enumerated from content/engine/ai + the
/// current game's data/games/<game>/ai directory. Sent as part
/// of AIListUpdate when a client subscribes to a room's AI list.
table RoomAIInfo {
    ai_id: string;
    display_name: string;
    description: string;
    is_engine_provided: bool;
}

table RoomListEntry {
    room_id: uint32;
    name: string;
    map_id: string;
    game_id: string;
    state: RoomState;
    player_count: uint8;
    max_players: uint8;
    has_password: bool;
    host_name: string;
}

table RoomListUpdate {
    rooms: [RoomListEntry];
}

table RoomStateUpdate {
    room_id: uint32;
    state: RoomState;
    name: string;
    map_id: string;
    game_id: string;
    players: [RoomPlayerInfo];
    countdown_seconds: uint8;   // 0 = no countdown
    game_server_port: uint16;   // port of spawned game server (0 = not started)
    ai_slots: [RoomAISlot];     // AI players added by the host
}

/// Reply to AIListRequest. Lists every AI plugin the server
/// discovered under the current game + engine roots. The client
/// uses this to populate the host's "Add AI" dropdown. The list
/// is stable for the lifetime of the lobby process; clients may
/// cache it and skip re-requesting unless they change game.
table AIListUpdate {
    ais: [RoomAIInfo];
}

/// One game plugin discovered under data/games. Shown in the
/// lobby's create-room dropdown. Named `LobbyGameInfo` to avoid
/// colliding with the existing `GameInfo` table which represents
/// live-sim state (map/game speed/frame/paused).
table LobbyGameInfo {
    id: string;          // stable folder-name id, used as game_id in RoomCreate
    display_name: string;
    description: string;
    version: string;
    /// Shader-lighting style the game wants the entity renderer to
    /// use, from modinfo.lua's `lighting` field. Empty / unknown values
    /// fall back to "gameplay" on the client. Recognised values:
    ///   "gameplay"  — half-Lambert + flat ambient floor (default)
    ///   "realistic" — true Lambert + low ambient, stronger contrast
    /// Mirrors the field on GameDiscovery::GameInfo; the HTTP
    /// /api/games endpoint surfaces the same string verbatim.
    lighting: string;
}

/// Reply to GameListRequest. Lists every game the lobby
/// discovered at startup.
table GameListUpdate {
    games: [LobbyGameInfo];
}

table RoomPlayerJoined {
    room_id: uint32;
    player: RoomPlayerInfo;
}

table RoomPlayerLeft {
    room_id: uint32;
    player_id: uint32;
    reason: string;
}

// ============================================================
// Map messages
// ============================================================

struct MapStartPos {
    x: float;
    z: float;
}

/// Sent by the lobby for map selection UI.
table MapInfo {
    id: string;
    name: string;
    short_name: string;
    description: string;
    author: string;
    version: string;
    mapx: uint16;
    mapy: uint16;
    width_elmos: uint32;
    height_elmos: uint32;
    min_height: float;
    max_height: float;
    max_players: uint8;
    start_positions: [MapStartPos];
    gravity: float;
    tidal_strength: float;
    max_metal: float;
    extractor_radius: float;
    minimap_url: string;        // HTTP URL for raw DXT1 minimap (cacheable)
    has_lua_gaia: bool;
}

/// List of maps for the lobby browser.
table MapListUpdate {
    maps: [MapInfo];
}

/// Map feature placed on the terrain.
table MapFeature {
    type_index: uint16;
    x: float;
    y: float;
    z: float;
    rotation: float;
    relative_size: float;
}

/// Definition of a feature type — corresponds 1:1 with an entry in
/// `MapData.feature_types` (same indices). Tells the client how to render
/// and interact with feature instances of this type. Parsed by the server
/// from the map's `features/*.lua` and converted into web-ready assets:
///
///   - `model_url` is an HTTP URL to a glTF 2.0 binary (`.glb`)
///     converted from the original `.s3o` via the modelimporter tool.
///   - `texture_url` is an HTTP URL to a PNG converted from the
///     original `.tga`/`.dds` via ImageMagick.
///
/// Both URLs may be empty strings if the def has no model (e.g. an
/// invisible decal feature) or its assets failed to convert; in that
/// case the client falls back to a placeholder.
table MapFeatureDef {
    name: string;             // canonical lowercase def key
    model_url: string;        // HTTP path to .glb (relative to lobby root)
    texture_url: string;      // HTTP path to .png (relative to lobby root)
    footprint_x: uint16;
    footprint_z: uint16;
    height: float;
    radius: float;
    blocking: bool;
    reclaimable: bool;
    metal: int32;
    energy: int32;
    damage: int32;            // hit points
}

/// Water rendering properties. Spring's water system is also used for
/// lava/acid/void-fill — the colour and damage distinguish them.
/// Water plane is at world Y = 0; terrain below that is flooded.
table MapWater {
    base_color: [float];      // 3 floats — bulk colour at depth
    surface_color: [float];   // 3 floats — colour at the surface
    min_color: [float];       // 3 floats — minimum colour (used when deep)
    surface_alpha: float;
    damage: float;            // damage per second to units in water
    void_water: bool;         // true = don't render plane, show void below
}

/// Splat/decal texture set — Spring's terrain detail texturing system.
/// All URLs are HTTP paths to PNG files (relative to the lobby HTTP root).
/// Empty string means the texture is not defined by the map.
table MapDecals {
    detail_tex: string;               // single detail texture fallback
    specular_tex: string;
    splat_detail_tex: string;         // old single-texture splat mode
    splat_distr_tex: string;          // RGBA distribution map (weights)
    splat_normal_0: string;           // per-channel detail+normal textures
    splat_normal_1: string;
    splat_normal_2: string;
    splat_normal_3: string;
    detail_normal_tex: string;        // global detail normal map
    splat_scales: [float];            // 4 floats, UV scale per channel
    splat_mults: [float];             // 4 floats, intensity per channel
}

/// Full map data sent by the game server on connect.
/// Binary data (heightmap, tileindex, typemap, metalmap) embedded directly.
/// Tile texture data and splat textures served via HTTP separately.
table MapData {
    mapx: uint16;
    mapy: uint16;
    square_size: uint8;
    min_height: float;
    max_height: float;
    tiles_x: uint16;
    tiles_z: uint16;
    num_tiles: uint32;
    tile_size: uint8;           // pixels per tile (32)
    start_positions: [MapStartPos];
    feature_types: [string];
    features: [MapFeature];
    /// Parallel to `feature_types` (same indices). Each entry tells the
    /// client how to render and interact with feature instances of that
    /// type.
    feature_defs: [MapFeatureDef];
    heightmap: [uint16];        // (mapx+1)*(mapy+1) corner heights
    tileindex: [int32];         // tilesX*tilesZ tile indices
    typemap: [ubyte];           // (mapx/2)*(mapy/2) terrain types
    metalmap: [ubyte];          // (mapx/2)*(mapy/2) metal density
    minimap_url: string;        // HTTP: raw DXT1 1024x1024 (cached from lobby)
    tiles_url: string;          // HTTP: raw DXT1, 512 bytes per tile, concatenated
    map_data_url: string;       // HTTP base URL for all /{filename} processed assets
    map_source_url: string;     // HTTP base URL for original map source files (Lua widgets, mapinfo.lua, author-supplied images)
    decals: MapDecals;
    water: MapWater;
    has_lua_gaia: bool;
    /// Paths (relative to map_source_url) of .lua files under LuaUI/Widgets/
    /// that the client should load into fengari on map start.
    widgets: [string];
}

/// One queued order for a unit. Mirrors Spring's Command struct.
/// `cmd_id` follows Spring conventions: positive values are CMD_*
/// constants (CMD_MOVE=10, CMD_ATTACK=20, …), negative values are
/// build orders where `-cmd_id` is the unit-def id to construct.
table UnitOrder {
    cmd_id: int32;
    /// Variable-length param vector. Common shapes:
    ///   move/attack:   [x, y, z]
    ///   target unit:   [unitId]
    ///   build:         [x, y, z, facing]
    ///   patrol/area:   [x, y, z, radius]
    params: [float];
    /// Bitfield: shift / alt / ctrl / right-mouse / internal-order.
    options: uint8;
    /// Unique tag assigned by the queue; used to address specific
    /// orders for editing / removal.
    tag: uint32;
    /// Frame this order auto-cancels at (INT_MAX = no timeout). The
    /// server emits the absolute frame to keep the client wire-format
    /// stateless across sim resyncs.
    timeout: int32 = 2147483647;
}

table UnitCommandQueue {
    unit_id: uint32;
    orders: [UnitOrder];
}

/// Per-session broadcast: every own-team unit's current order queue.
/// Sent at low cadence (~1 Hz) — queues change far slower than entity
/// state, and most units have queue size 0..3. The client treats each
/// snapshot as a complete replacement of its queue cache.
table UnitCommandQueuesUpdate {
    queues: [UnitCommandQueue];
}

/// One available command/button on a unit's command panel. ZK-style
/// games attach build options dynamically per unit (via Spring.InsertUnitCmdDesc),
/// so the static UnitDef.build_options list is not authoritative — the client
/// needs the live cmd-desc list to know what each selected unit can build.
///
/// The server streams **all** cmd-descs for selected units (build commands,
/// standard orders like Move/Attack/Patrol, state toggles like FIRE_STATE).
/// To keep bandwidth in check, UnitCmdDescsUpdate is scoped to the
/// currently-selected units (see SelectionState).
table UnitCmdDesc {
    /// Spring command id. Negative IDs are build commands where
    /// -cmd_id is the unit-def id to construct.
    cmd_id: int32;
    /// True if greyed-out (not currently buildable due to tech, resources, etc.).
    disabled: bool = false;
    /// Human-readable name shown on the button ("Move", "Attack",
    /// "Patrol"). For build commands this is the unit-def display name.
    name: string;
    /// Action binding name ("move", "areaattack", "buildunit_armcom").
    /// Looked up by widgets to bind hotkeys via Spring.GetKeyBindings.
    action: string;
    /// Texture path / atlas key for the button glyph. May be an
    /// engine-relative path ("Anims/cursormove.png"), a #-prefixed
    /// generated icon ("#armcom" → ZK build-icon atlas), or empty.
    texture: string;
    /// Tooltip body shown on hover. May contain Spring's standard
    /// markup (\n, color codes).
    tooltip: string;
    /// CMDTYPE_* constant (0=ICON, 5=ICON_MODE, 10=ICON_MAP, 12=ICON_UNIT,
    /// 20=ICON_BUILDING, …). Drives the UI's interaction model: ICON
    /// fires immediately, ICON_MAP cycles into ground-pick mode, etc.
    type: int32 = 0;
    /// Mode-specific parameter strings. For CMDTYPE_ICON_MODE, params[0]
    /// is the current state index as a decimal string ("0", "1", "2")
    /// and params[1..n] are the human labels ("Hold fire", "Return
    /// fire", "Fire at will"). Empty for non-stateful commands.
    params: [string];
    /// True if the cmd-desc should be hidden from the command panel
    /// (some widgets stash internal commands here).
    hidden: bool = false;
}

table UnitCmdDescs {
    unit_id: uint32;
    cmds: [UnitCmdDesc];
}

/// Per-session broadcast: every own-team unit's available command list,
/// filtered to build commands. Sent at low cadence (~1 Hz). Client treats
/// each snapshot as a complete replacement of its cmd-desc cache.
table UnitCmdDescsUpdate {
    units: [UnitCmdDescs];
}

/// One transport relationship. Lists a transporter and the units it
/// is currently carrying. Cargo unit ids appear in the order
/// `CUnit::transportedUnits` holds them; a transporter with empty
/// cargo is omitted from the update entirely.
table UnitTransportInfo {
    transporter_id: uint32;
    cargo: [uint32];
}

/// Per-session broadcast: every transport relationship visible to the
/// session. Sent every ~1 Hz alongside UnitCommandQueuesUpdate.
/// The client treats each snapshot as a complete replacement of its
/// transport cache: any transporter not listed has empty cargo, any
/// cargo not listed has no transporter.
///
/// Visibility matches the UnitCommandQueuesUpdate filter (own-team +
/// allied teams). The transport message is intentionally a full
/// snapshot rather than per-event delta — at 1 Hz the bandwidth cost
/// is negligible (most teams have 0..few transports), and snapshots
/// are self-healing across packet loss / reconnect.
table UnitTransportUpdate {
    transports: [UnitTransportInfo];
}

/// One unit's self-destruct countdown state.
table UnitSelfDInfo {
    unit_id: uint32;
    /// Game-seconds remaining on the self-destruct countdown. Matches
    /// Spring's `CUnit::selfDCountdown` directly (decremented once per
    /// game-second, not per frame). 0 = not self-destructing.
    seconds_remaining: uint16;
}

/// Per-session broadcast: every visible unit with a non-zero
/// self-destruct countdown. Snapshot semantics: any unit not listed
/// has no active self-destruct. Sent every ~1 Hz.
table UnitSelfDUpdate {
    units: [UnitSelfDInfo];
}

/// One unit's stockpile-weapon state. Emitted only for units whose
/// stockpileWeapon is non-null AND has non-zero counters or in-flight
/// build progress (so most units never appear here).
table UnitStockpileInfo {
    unit_id: uint32;
    /// Number of missiles currently ready to fire.
    ready: uint16;
    /// Number of additional missiles queued for production.
    queued: uint16;
    /// Build progress on the in-flight missile, 0.0..1.0.
    /// Matches Spring's `CWeapon::buildPercent`.
    build_percent: float;
}

/// Per-session broadcast: every visible unit with active stockpile
/// state. Snapshot semantics. Sent every ~1 Hz.
table UnitStockpileUpdate {
    units: [UnitStockpileInfo];
}

/// One unit's armored toggle state. Spring tracks two fields per
/// unit: a bool `armoredState` (currently armored?) and a float
/// `armoredMultiple` (damage multiplier while armored, typically 0.5).
/// Emitted only for units whose armoredState is true OR whose
/// armoredMultiple differs from 1.0 — units in the default
/// non-armored state with multiplier 1.0 are omitted entirely.
table UnitArmoredInfo {
    unit_id: uint32;
    armored: bool;
    armored_multiple: float;
}

/// Per-session broadcast: every visible unit with non-default armored
/// state. Snapshot semantics. Sent every ~1 Hz.
table UnitArmoredUpdate {
    units: [UnitArmoredInfo];
}

/// Classifies a UnitLifecycleEvent. Matches `UnitLifecycleKind` in
/// `Server/UnitLifecycleCollector.h`. These are events that widgets
/// need to learn about but can't be derived from the per-tick entity
/// stream — UnitFromFactory needs the factory id, and Taken/Given
/// need the transfer cause (the entity stream just shows the new team).
enum UnitLifecycleKind : uint8 {
    FromFactory = 0,
    Taken       = 1,
    Given       = 2,
    /// Spring's synced `UnitCreated(unit, builder)`. Fires the moment
    /// construction starts (before nano-spray). For own + allied teams
    /// only — enemy UnitCreated is synthesised client-side from
    /// first-visibility in the entity stream.
    Created     = 3,
}

table UnitLifecycleEvent {
    kind: UnitLifecycleKind;
    unit_id: uint32;
    unit_def_id: uint16;
    unit_team: uint8;
    /// FromFactory: the factory unit id. 0 for Taken/Given.
    factory_id: uint32 = 0;
    /// FromFactory: the factory def id. 0 for Taken/Given.
    factory_def_id: uint16 = 0;
    /// FromFactory: true if the unit was built via a player-issued
    /// build command, false if produced from a queued template.
    user_orders: bool = false;
    /// Taken/Given: pre-transfer team. -1 for FromFactory.
    old_team: int8 = -1;
    /// Taken/Given: post-transfer team. -1 for FromFactory.
    new_team: int8 = -1;
    /// Created: the initiating builder unit id. 0 = no builder
    /// (Spring.CreateUnit without a builder argument, or unit produced
    /// through some other code path). 0 for FromFactory/Taken/Given.
    builder_id: uint32 = 0;
}

/// Per-tick batch of lifecycle events. Typically empty on quiet ticks;
/// populated on factory completion, AllowResourceTransfer, etc.
/// FromFactory / Taken / Given are broadcast unfiltered (transfers are
/// public). Created is filtered per-session to the viewer's ally team
/// (enemy UnitCreated is synthesised client-side from first-visibility).
table UnitLifecycleBatch {
    events: [UnitLifecycleEvent];
}

/// One feature spawned on the server this tick. Covers wrecks created
/// by `CFeatureHandler::CreateWreckage` on unit death, debris dropped
/// by explosions, Lua `Spring.CreateFeature` calls, and any other
/// runtime-spawned `CFeature`. Map-placed features arrive via
/// `MapData.features` at game start, not here — only dynamic spawns.
///
/// `team` is the owning team (controls reclaim rights); -1 means
/// gaia/neutral. `ally_team` lets the server filter visibility client-
/// side (we still broadcast unfiltered for simplicity since wrecks are
/// usually visible to everyone, but the field is here so per-team
/// filtering can be added without a schema bump).
table FeatureSpawn {
    feature_id: uint32;
    def_id: uint32;
    x: float;
    y: float;
    z: float;
    /// Spring heading: 16-bit fixed-point angle (0 = +Z, 16384 = +X).
    heading: int16 = 0;
    /// Build facing 0..3 (south/east/north/west), copied from the parent
    /// unit's facing when the wreck inherits it.
    build_facing: uint8 = 0;
    team: int8 = -1;
    ally_team: int8 = -1;
}

/// Per-tick batch of feature lifecycle events. Empty on quiet ticks;
/// populated when units die (wreck spawn), buildings collapse, debris
/// drops, or gadget code calls `Spring.CreateFeature` / `DestroyFeature`.
table FeatureLifecycleBatch {
    spawns: [FeatureSpawn];
    /// Feature IDs removed this tick (reclaimed, destroyed, despawned).
    /// Parallel to `spawns` order — the client just plays back both.
    removed: [uint32];
}

/// Classifies a UnitCommandEvent. `Issued` fires after the engine has
/// added a command to a unit's queue (Spring's `UnitCommand` callin);
/// `Done` fires when a queued command completes or is cleared
/// (`UnitCmdDone`).
enum UnitCommandKind : uint8 {
    Issued = 0,
    Done   = 1,
}

/// Server → Client: one per `UnitCommand` / `UnitCmdDone` event. Mirrors
/// the arguments LuaUI widgets receive on the matching callins. The
/// `tag` matches the value the queue snapshot reports for the same
/// command — widgets can correlate an Issued event with its later Done.
table UnitCommandEvent {
    kind: UnitCommandKind;
    unit_id: uint32;
    unit_def_id: uint16;
    unit_team: uint8;
    cmd_id: int32;
    params: [float];
    options: uint8;
    tag: uint32;
    /// Spring's `playerNum`. `-1` (= 255 unsigned) for system / Lua / AI
    /// issued commands; player-issued events carry the originating player.
    player_id: int16 = -1;
    /// True when the command was issued by sim Lua (LuaRules, gadget:),
    /// false when issued by player input or the engine's own scheduling.
    from_synced: bool = false;
    /// True when the command was issued by any Lua context (synced or
    /// unsynced), false for engine / network-decoded sources.
    from_lua: bool = false;
}

/// Per-tick batch of command events. Filtered server-side to the union
/// of every viewer's allied teams — widgets only see commands on units
/// they're allowed to observe (own team + alliance).
table UnitCommandBatch {
    events: [UnitCommandEvent];
}

/// Server → Client: result of a `PathRequest`. The `request_id` matches
/// the one the client supplied. `waypoints` is the full path from
/// `start` to (a point within `goal_radius` of) `end`; empty if no
/// path was found within the requested constraints. `length` is the
/// total path length in elmos — useful for build-time estimates and
/// "is target reachable" checks (compare against straight-line
/// distance + builder range).
///
/// Send-exactly-once semantics: every PathRequest produces exactly one
/// PathResponse, even on failure (with empty `waypoints`). After
/// PathResponse, the corresponding server-side path is released — the
/// client must request a fresh path for any future query.
table PathResponse {
    request_id: uint32;
    waypoints: [Vec3];
    length: float;
}

/// Server → Client: per-standing-order snapshot of state visible to
/// this client. Fields not derivable from the original Create message:
///   - order_id   server-assigned, stable for the lifetime of the order
///   - owner_team team that issued the order
///   - assigned_squad_count   number of squads currently working it
///   - created_at_frame       sim frame when the order was created
///   - expires_at_frame       absolute sim frame the order auto-removes
///                            (0 = no expiry)
table StandingOrderInfo {
    order_id: uint32;
    owner_team: uint8;
    type: StandingOrderType;
    priority: uint8;
    params: [float];
    conditions: StandingOrderConditions;
    assigned_squad_count: uint16;
    active: bool = true;
    expires_at_frame: uint32;
    created_at_frame: uint32;
}

/// Server → Client: snapshot of all standing orders the client is
/// allowed to see. Filtering rules:
///   - Always include orders owned by the client's team.
///   - Include allied-team orders (allies see each other's plans).
///   - Enemy orders are never sent.
/// Sent on any standing-order state change (create / update / remove /
/// assignment-count change), NOT per-tick. The assigned_squad_count
/// field on each StandingOrderInfo updates only when a squad is added
/// or released — squad churn under a stable count does not push a
/// snapshot.
table StandingOrderState {
    orders: [StandingOrderInfo];
}

// ============================================================
// Macro C&C — server → client state (PLAN-macro-directives §1)
// Broadcast on change, snapshot on auth — same visibility model as
// StandingOrderState (own team + allies, never enemy). Low rate, high
// debounce; never per-tick.
// ============================================================

/// One org group in the team's org tree. `echelon`/`parent_id` are streamed
/// regardless of the v0 platoon-only surface so the client OOB tree is
/// already tier-shaped (PLAN-macro-directives §1 field discipline).
table OrgGroupInfo {
    group_id: uint32;
    echelon: Echelon;
    owner_team: uint8;
    parent_id: uint32;
    name: string;
    member_ids: [uint32];
    current_directive_id: uint32;   // active macro order, 0 = none
    posture_json: string;
    created_at_frame: uint32;
}

table OrgGroupState {
    groups: [OrgGroupInfo];
}

/// One macro directive, incl. fulfillment (macro-orders §4.3 demand model):
/// `assigned_strength / requested_strength` reports understrength/fulfilled.
table DirectiveInfo {
    directive_id: uint32;
    owner_team: uint8;
    group_id: uint32;               // 0 = condition-scoped
    type: DirectiveType;
    priority: uint8;
    shape: OrderShape;
    params: [float];
    conditions: StandingOrderConditions;
    requested_strength: uint32;
    assigned_strength: uint32;      // fulfillment numerator (aggregate HP assigned)
    assigned_squad_count: uint16;
    phases_json: string;
    active: bool = true;
    expires_at_frame: uint32;
    created_at_frame: uint32;
}

table DirectiveState {
    directives: [DirectiveInfo];
}

/// One variadic argument from `Spring.SendToUnsynced(...)`. The server
/// validates synced-side that args are one of nil/bool/number/string
/// (see CSyncedLuaHandle::SendToUnsynced) so the wire mirrors exactly
/// those four cases. `num_val` is double to preserve Lua's full
/// `number` precision.
enum SendToUnsyncedArgKind : uint8 {
    Nil = 0,
    Bool = 1,
    Number = 2,
    String = 3,
}

table SendToUnsyncedArg {
    kind: SendToUnsyncedArgKind;
    num_val: double;
    bool_val: bool;
    str_val: string;
}

/// Server → Client: forwarded `Spring.SendToUnsynced(...)` call from a
/// synced LuaRules gadget. The first arg is conventionally the topic
/// string (by ZK convention and matching upstream
/// `CUnsyncedLuaHandle::RecvFromSynced` semantics); the worker peels
/// args[0] and looks up the handler registered via
/// `gadgetHandler:AddSyncAction(topic, fn)`. `client_id == 0` is
/// broadcast to every client (today the only case — the synced call
/// has no per-player addressing).
table SendToUnsyncedEvent {
    client_id: uint32;
    args: [SendToUnsyncedArg];
}

/// Server → Client: a relayed `Spring.SendLuaUIMsg` from another (or the
/// same) player. The server has already applied the audience filter (the
/// `mode` from the originating `LuaUIMsg`, evaluated against this receiver's
/// team/spectator state per Recoil `CLuaHandle::HandleLuaMsg`), so the client
/// dispatches unconditionally to `widget:RecvLuaMsg(data, player_id)`.
/// `player_id` is the sender's player number (server-resolved).
table LuaUIMsgRelay {
    data: [uint8];
    player_id: int32;
}

/// The concrete type of a RulesParamEntry value. `Nil` means "delete this
/// key from the client mirror" (matches the client consumer's `null →
/// delete` path and Spring's rules-param clearing). Spring can also store a
/// *boolean* rules param; the server encodes booleans as `Number` (0.0/1.0)
/// because the client rules-param mirror type is `number | string` and has
/// never carried booleans. **CALLED-OUT divergence from Recoil:** a `false`
/// bool param reads back as `0` (truthy in Lua) rather than `false`. No
/// current Metalstorm/ZK/BAR consumer sets a boolean rules param; the
/// faithful fix (add a `Bool` kind + widen `RulesParamValue`) is deferred
/// until one does. See StateStreamer::BroadcastRulesParams.
enum RulesParamValueKind : uint8 {
    Nil = 0,
    Number = 1,
    String = 2,
}

/// One rules-param key→value change. `value_kind` selects which value field
/// is live (`num_val` for Number, `str_val` for String, neither for Nil).
/// W3 optimization: prefer key_id over key when both present.
table RulesParamEntry {
    key: string;         // legacy: full string key (for backward compat)
    key_id: uint16;      // W3: interned key ID (0 = not interned, use key)
    value_kind: RulesParamValueKind;
    num_val: double;
    str_val: string;
}

/// Which rules-param scope a RulesParamUpdate carries. `Game` params are the
/// global `Spring.SetGameRulesParam` map (broadcast unfiltered — matching
/// `Spring.GetGameRulesParams`, which is unconditionally public). `Team`
/// params are `Spring.SetTeamRulesParam`, LOS-filtered per receiving session.
enum RulesParamScope : uint8 {
    Game = 0,
    Team = 1,
}

/// Server → Client: a per-sim-tick batch of rules-param changes for ONE
/// scope (+ id for Team scope). Consumed by the LuaUI worker's
/// `handleRulesParamUpdate`, feeding `Spring.GetGameRulesParam(s)` /
/// `Spring.GetTeamRulesParam(s)` in widgets/gadgets.
///
/// `id` is the teamID for Team scope (ignored for Game). `replace = true`
/// asks the client to clear the target map before applying — used only for
/// the join/rejoin snapshot so a late joiner converges exactly to current
/// state; per-tick deltas use `replace = false`.
///
/// **Visibility** (replicates `LuaSyncedRead::GetTeamRulesParam(s)`): Team
/// batches are filtered server-side per connection against each param's
/// `los` bitmask — same-ally sessions see PRIVATE-and-below, allied-team
/// sessions see ALLIED-and-below, everyone sees PUBLIC; spectators (team < 0)
/// see all. Game batches are broadcast to every client.
table RulesParamUpdate {
    scope: RulesParamScope;
    id: uint32;
    replace: bool;
    params: [RulesParamEntry];
    params_rev: uint32;  // W3: generation counter for snapshot validation
}

/// W3: Key interning dictionary for RulesParamEntry key_id references.
/// Sent once on join (or on dictionary resync if rev mismatch).
table RulesParamKeyDictionary {
    keys: [string];         // indexed by key_id (0 reserved for "not interned")
    dictionary_rev: uint32; // dictionary version for mismatch detection
}

// Union of all server→client message types
union ServerPayload {
    AuthResponse,
    EntityCreate,
    EntityDestroy,
    GameEventBatch,
    ResourceUpdate,
    Pong,
    ChatReceive,
    GameInfo,
    ReconnectResponse,
    ServerError,
    RoomListUpdate,
    RoomStateUpdate,
    RoomPlayerJoined,
    RoomPlayerLeft,
    MapListUpdate,
    MapData,
    AIListUpdate,
    GameListUpdate,
    PlayerLeft,
    LogBatch,
    ConsoleResponse,
    GameStarted,
    GameRestarting,
    UnitCommandQueuesUpdate,
    UnitCmdDescsUpdate,
    EntitySensorUpdate,
    UnitTransportUpdate,
    UnitSelfDUpdate,
    UnitStockpileUpdate,
    UnitArmoredUpdate,
    UnitLifecycleBatch,
    UnitCommandBatch,
    PathResponse,
    StandingOrderState,
    FeatureLifecycleBatch,
    SendToUnsyncedEvent,
    TeamStartInfo,
    PlayerTeamEventBatch,
    LuaUIMsgRelay,
    TeamStatsHistoryBatch,
    GameModOptions,
    OrgGroupState,
    DirectiveState,
    RulesParamUpdate,
    RulesParamKeyDictionary,
    PlayerRoster,
}

table ServerMessage {
    payload: ServerPayload;
}

// Root types — one for each direction
root_type ClientMessage;
