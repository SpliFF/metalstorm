{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "spring-debug": {
      "command": "node",
      "args": ["tools/debug-mcp/server.js"],
      "env": {
        "LOBBY_URL": "http://127.0.0.1:8011",
        "GAME_SERVER_URL": "http://127.0.0.1:9100",
        "LOG_SERVER_URL": "http://127.0.0.1:8010"
      }
    }
  }
}
