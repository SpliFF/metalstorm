{
  "_comment": "Contract v2's focus half: TARGET ELISION (a verb with no target at all takes the drilled panel's place), the two verbs that must NOT elide, a proposal's `target` binding, and the camera deixis that has no antecedent to bind to. Every `expected` names the RESOLVED thing — rule 10 — because with a focus in context the model's job is to write what it read, not to echo the pronoun. The offline path reaches the same envelopes through `bindFocusReferences`, which is the property that makes the two producers interchangeable.",
  "fixtures": [
    {
      "name": "\"attack\" with a town drilled — the town is the target",
      "utterance": "attack",
      "context": "basin-town-drilled",
      "note": "Nothing is selected, so the subject stays team-wide. Elision supplies only the TARGET: a drilled panel is where, never who.",
      "expected": {
        "say": "Attacking Randtown.",
        "actions": [
          {
            "kind": "command",
            "intent": {
              "verb": "attack",
              "subject": {
                "type": "any"
              },
              "target": {
                "type": "entity-ref",
                "name": "Randtown"
              }
            }
          }
        ]
      },
      "expect": {
        "sends": [
          {
            "type": "GroupDirective",
            "groupId": 0
          }
        ],
        "refusals": 0
      }
    },
    {
      "name": "\"defend\" elides the same way",
      "utterance": "defend",
      "context": "basin-town-drilled",
      "expected": {
        "say": "Defending Randtown.",
