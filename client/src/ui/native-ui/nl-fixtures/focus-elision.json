              "target": {
                "type": "entity-ref",
                "name": "Randtown"
              }
            }
          }
        ]
      },
      "expect": {
        "sends": [
          {
            "type": "StandingOrder"
          }
        ]
      },
      "note": "A team-wide (`any`) subject on a standing verb compiles to a StandingOrder, not a GroupDirective: `groupId 0` is the compile table's condition-scoped subject and there is no group to direct. Pinned here because the two wire types reach completely different gadget handlers."
