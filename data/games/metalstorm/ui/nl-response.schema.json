              }
            },
            "required": [
              "kind",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "say": {
      "type": "string",
      "description": "One short spoken line confirming what is happening, e.g. \"Moving 2 tank squads to Randtown\". Present tense, no preamble."
    },
    "clarify": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "description": "One question, asked plainly."
        },
        "options": {
          "type": "array",
          "description": "Up to 6 concrete choices, each a name from the context.",
          "items": {
            "type": "string"
          }
        },
        "pick": {
          "type": "integer",
          "description": "How many of the options the answer needs. Omit for one. Use it when the sentence asked for several (\"which two of these four squads?\")."
        }
      },
      "required": [
        "question"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "actions"
  ],
  "additionalProperties": false
}
