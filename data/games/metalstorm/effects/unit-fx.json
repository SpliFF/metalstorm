  "scaleOverrides": {
    "_doc": "Per-class per-scale death escalation. Scale 4 = super-heavy: the staged dreadnought death for land armour; buildings/ships keep their class death at every scale for now (STUB tuning). `sound` steps up to vehicle_heavy at s3/s4, matching the visual escalation.",
    "tanks":     { "1": { "death": "death_vehicle_s1" }, "3": { "death": "death_vehicle_s3", "sound": "death_vehicle_heavy" }, "4": { "death": "death_dreadnought", "sound": "death_vehicle_heavy" } },
    "mechs":     { "1": { "death": "death_vehicle_s1" }, "3": { "death": "death_vehicle_s3", "sound": "death_vehicle_heavy" }, "4": { "death": "death_dreadnought", "sound": "death_vehicle_heavy" } },
    "artillery": { "1": { "death": "death_vehicle_s1" }, "3": { "death": "death_vehicle_s3", "sound": "death_vehicle_heavy" }, "4": { "death": "death_dreadnought", "sound": "death_vehicle_heavy" } },
    "staticdefense": { "4": { "death": "death_building" } }
  },

  "units": {
    "_doc": "Exact def-name overrides — highest precedence. Empty until specific defs demand bespoke deaths (e.g. a named scenario hero)."
  }
}
