{
  "_doc": [
    "Metalstorm weapon -> FX/SFX resolution map. The native-game analogue of the ",
    "BAR/ZK client dispatch (client/src/core/weapon-fx-dispatch.ts effectForFire / ",
    "effectForImpact), but data instead of code: no cegTag/explosionGenerator ",
    "strings on the defs — the client FX dispatch reads THIS table keyed by weapon ",
    "def name (weapons/weapons.lua) and resolves each slot to a named effect in ",
    "effects/library.json and a SoundItem in gamedata/sounds.lua.",
    "",
    "Slots per weapon:",
    "  muzzle     -> library effect fired at the barrel on weapon_fired (or null)",
    "  projectile -> library tracer style attached to the flying round (or null)",
    "  trail      -> library trail style streamed behind the round (or null)",
    "  impact     -> library effect at the detonation point",
    "  fireSound  -> sounds.lua SoundItem key (matches weapons.lua soundstart)",
    "  impactSound-> sounds.lua SoundItem key",
    "",
    "Resolution order (client dispatch): exact weapon-name entry -> `defaults` by ",
    "weapontype -> `__fallback`. Keeps every weapon rendering SOMETHING even before ",
    "per-weapon tuning (mirrors combat-fx.ts __default_explosion behaviour)."
  ],
  "version": 1,

  "defaults": {
    "_doc": "Fallback by Recoil weapontype when a weapon has no explicit entry.",
    "Cannon":          { "muzzle": "muzzle_ac",      "projectile": "tracer_ac", "trail": null,           "impact": "expl_small", "fireSound": "ac_fire",         "impactSound": "blast_small" },
    "MissileLauncher": { "muzzle": "launch_missile",  "projectile": null,        "trail": "trail_missile","impact": "expl_medium","fireSound": "missile_launch",  "impactSound": "blast_med" },
    "TorpedoLauncher": { "muzzle": "launch_torpedo",  "projectile": null,        "trail": "wake_torpedo", "impact": "underwater_burst", "fireSound": "torpedo_launch", "impactSound": "blast_water" },
    "AircraftBomb":    { "muzzle": null,              "projectile": null,        "trail": null,           "impact": "expl_large", "fireSound": "bomb_release",    "impactSound": "blast_large" }
  },

  "__fallback": { "muzzle": null, "projectile": null, "trail": null, "impact": "__default_explosion", "fireSound": null, "impactSound": "blast_small" },

