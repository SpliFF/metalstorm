// Metalstorm move classes. `speedmodclass` is an ENGINE SLOT INDEX, not a
// free label: rts/Sim/MoveTypes/MoveDefHandler.h SpeedModClass is
// Tank=0, KBot=1, Hover=2, Ship=3. The slot picks BOTH the mapinfo
// terrainTypes.moveSpeeds field the class reads (tank/kbot/hover/ship) AND
// the speed-mod curve CMoveMath::GetPosSpeedMod applies -- Ship gets
// ShipSpeedMod (flat 1.0 wherever it floats), everything else gets a GROUND
// curve with a slope term and a depth penalty.
//
// SHIP/SUB were declared 1 (KBot) until 2026-08-19 and so read a ground
// speed-mod: a boat in 29 elmos of water ran at 1/(1+0.1*29) = 0.26 of its
// maxSpeed and steered for the shallows. PLAN-maps.md 2e.1/2o, option C.
//
// INFANTRY is still 2 (Hover) and is still mis-declared -- it takes
// HoverSpeedMod rather than GroundSpeedMod for slope. That is a separate
// measured milestone (PLAN-maps.md 2o: "B for infantry later"); do not
// change it here without one.
//
// Reviewed vs BAR movedefs ballparks 2026-08-20 (unit props pass): the
// maxslope ladder (45/32/24) matches BAR's bot > light-veh > heavy ordering,
// maxwaterdepth rises with hull size (12/20/30 -- fording depth scales with
// vehicle), minwaterdepth 12/20 for SHIP/SUB and the crushstrength ladder
// (5/50/500, ships 200) are all in BAR range. No numeric changes made.

[CLASS0]
{
    name=INFANTRY;
    footprintx=1;
    footprintz=1;
    maxwaterdepth=12;
    maxslope=45;
    crushstrength=5;
    speedmodclass=2;
}

[CLASS1]
{
    name=VEH;
    footprintx=2;
    footprintz=2;
    maxwaterdepth=20;
    maxslope=32;
    crushstrength=50;
    speedmodclass=0;
}

[CLASS2]
{
    name=HEAVY;
    footprintx=4;
    footprintz=4;
    maxwaterdepth=30;
    maxslope=24;
    crushstrength=500;
    speedmodclass=0;
}

[CLASS3]
{
    name=SHIP;
    footprintx=4;
    footprintz=4;
    minwaterdepth=12;
    crushstrength=200;
    speedmodclass=3;
}

[CLASS4]
{
    name=SUB;
    footprintx=3;
    footprintz=3;
    minwaterdepth=20;
    crushstrength=100;
    speedmodclass=3;
    // Without subMarine the SUB class paths like a surface ship
    // (MoveDefHandler.cpp:235 reads it).
    subMarine=1;
}
