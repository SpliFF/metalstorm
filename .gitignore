# Build output
/build/
/engine/build/
/client/dist/
node_modules/

# IDE / editor
.idea/
*.xcodeproj/
*.xcworkspace/
*.swp
*~

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json

# Ninja
.ninja_log
.ninja_deps
build.ninja
rules.ninja

# Compiled objects
*.o
*.so
*.a
*.dylib
*.dll
*.exe
*.obj

# Generated
/src-generated/

# OS files
.DS_Store
Thumbs.db

# clangd cache
.cache/

# User-specific CMake overrides
CMakeUserPresets.json

# Runtime files
*.log
springsettings.cfg
infolog.txt

# Environment files (dev secrets, port overrides)
.env
.env.local
.env.*.local

# Server data (SQLite databases, runtime state)
/data/games/*
/data/maps/*
/data/logs/*
/data/*.db*

# Game content (maps, games — large external files, not committed)
/content/*
!/content/games/
/content/games/*
!/content/games/papertanks/

# Game cache
/cache/

# VS Code user settings (workspace file IS committed, user prefs are not)
.vscode/*.code-snippets

# Claude Code — share skills via repo, keep everything else untracked
!.claude/
.claude/*
!.claude/skills/
