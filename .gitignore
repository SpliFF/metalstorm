# Build output
/build/
/engine/build/
/client/dist/
node_modules/

# IDE / editor
.idea/
*.xcodeproj/
*.xcworkspace/
*.swp
*~

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json

# Ninja
.ninja_log
.ninja_deps
build.ninja
rules.ninja

# Compiled objects
*.o
*.so
*.a
*.dylib
*.dll
*.exe
*.obj

# Generated
/src-generated/

# OS files
.DS_Store
Thumbs.db

# clangd cache
.cache/

# User-specific CMake overrides
CMakeUserPresets.json

# Runtime files
*.log
springsettings.cfg
infolog.txt

# Environment files (dev secrets, port overrides)
.env
.env.local
.env.*.local

# Server data (SQLite databases, runtime state)
/data/games/*
# …except Metalstorm: the NATIVE game is authored in-tree (PLAN-metalstorm.md
# §9 — no content/ source, no gameconverter) and bundled with the engine, so
# it must be tracked (same pattern as papertanks below).
!/data/games/metalstorm/
/data/maps/*
/data/logs/*
# data/engine/ is a BUILD OUTPUT (the .ktx2 engine bitmaps are generated by a
# repo script; original Spring engine assets shipped as a separate licensing
# download). It's served to the browser at /api/engine/data/* but built on
# demand, never committed. Raw-source provenance is still TBD.
/data/engine/*
/data/*.db*

# Game content (maps, games — large external files, not committed)
/content/*
/content/games/*
!/content/games/papertanks/

# Game cache
/cache/

# VS Code user settings (workspace file IS committed, user prefs are not)
.vscode/*.code-snippets

# Claude Code — share skills via repo, keep everything else untracked
!.claude/
.claude/*
!.claude/skills/

# Vite development server for frontend
/client/.vite

# MCP tool
tools/debug-mcp/node_modules/


# chrome-devtools MCP screenshot output
/.playwright-mcp/

# Python bytecode cache (tools/scripts/*.py)
__pycache__/
*.pyc
