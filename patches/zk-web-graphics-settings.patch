-		optionFunction = function(self) Spring.SendLuaMenuMsg("openSettingsTab Graphics") end,
+		optionFunction = function(self) if WG.OpenGraphicsPanel then WG.OpenGraphicsPanel() else Spring.SendLuaMenuMsg("openSettingsTab Graphics") end end,
