--- a/content/games/zk/scripts/vehraid.lua
+++ b/content/games/zk/scripts/vehraid.lua
@@ -78,6 +78,14 @@
 				local ztilta = (s1r + s2r - s1l - s2l)/10000
 				ztiltv = ztiltv*0.99 + ztilta
 				ztilt = ztilt*0.99 + ztiltv
+				-- springrts-web: keep the integrator inside the small-angle
+				-- basin. Slight heightmap noise on otherwise-flat ground
+				-- accumulates past ~π/2, the feedback flips sign, and the
+				-- loop converges to the upside-down (±π) equilibrium where
+				-- pieces become symmetric again — leaving the vehicle stuck
+				-- on its side. ~34° gives normal slope tracking headroom.
+				if ztilt > 0.6 or ztilt < -0.6 then ztilt, ztiltv = 0, 0 end
+				if xtilt > 0.6 or xtilt < -0.6 then xtilt, xtiltv = 0, 0 end
 
 				local ya = (s1r + s2r + s1l + s2l)/1000
 				yv = yv*0.99 + ya
